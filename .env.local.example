# Supabase 프로젝트 설정 (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# 관리자 로그인 비밀번호 (본인만 아는 값으로 변경)
ADMIN_PASSWORD=change-me

# 로그인 성공 시 발급되는 세션 토큰 (긴 랜덤 문자열로 직접 생성해서 넣기)
# 터미널에서 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_TOKEN=change-me-too-a-long-random-string

# Vercel Cron이 자동 삭제 API를 호출할 때 쓰는 비밀값 (역시 랜덤 문자열)
CRON_SECRET=change-me-cron-secret

# 상담일 이후 예약 정보를 보관할 기간(일). 지나면 자동 삭제됨
RETENTION_DAYS=90
