# Supabase 프로젝트 설정 (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# 구글 로그인 허용 목록. 여기 없는 구글 계정은 로그인해도 관리자 페이지에 들어올 수 없음.
# (Google Cloud Console OAuth 동의 화면의 Test users에도 같은 이메일을 등록해둬야 함)
ADMIN_ALLOWLIST=[{"email":"a@gmail.com","name":"이름1"},{"email":"b@gmail.com","name":"이름2"}]

# Vercel Cron이 자동 삭제 API를 호출할 때 쓰는 비밀값 (랜덤 문자열)
# 터미널에서 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me-cron-secret

# 상담일 이후 예약 정보를 보관할 기간(일). 지나면 자동 삭제됨
RETENTION_DAYS=90
